---
import BaseLayout from '../layouts/BaseLayout.astro';
import { livros } from '../data/livros/uma-vida-com-propositos';

const dadosLivros = JSON.stringify(livros);
---

<BaseLayout
  title="Leitura — Uma Vida com Propósitos"
  description="Acompanhe o desafio de 40 dias do livro Uma Vida com Propósitos de Rick Warren."
>
  <div id="leitura-root" class="min-h-screen font-sans lp-root">

    <!-- Header -->
    <header class="lp-header fixed top-0 left-0 right-0 z-50 backdrop-blur-sm">
      <div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-end">
        <button
          id="btn-tema"
          class="lp-tema-btn w-9 h-9 rounded-lg flex items-center justify-center transition-all"
          title="Alternar tema"
          aria-label="Alternar entre modo claro e escuro"
        >
          <!-- Ícone sol (light mode) -->
          <svg id="icon-sol" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" class="hidden">
            <path d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"/>
          </svg>
          <!-- Ícone lua (dark mode) -->
          <svg id="icon-lua" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 256 256" fill="currentColor">
            <path d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23Z"/>
          </svg>
        </button>
      </div>
    </header>

    <main class="pt-14 pb-16">

      <!-- VIEW: Seleção de Livro -->
      <div id="view-livros" class="max-w-4xl mx-auto px-4 py-12">
        <div class="mb-10">
          <h1 class="text-3xl font-bold lp-text-primary mb-2">Minha Leitura</h1>
          <p class="lp-text-muted">Selecione um livro para começar ou continuar sua leitura.</p>
        </div>
        <div id="lista-livros" class="grid gap-4 sm:grid-cols-2"></div>
      </div>

      <!-- VIEW: Grade de Dias -->
      <div id="view-dias" class="max-w-4xl mx-auto px-4 py-12 hidden">
        <button id="btn-voltar-livros" class="lp-link mb-8 text-sm flex items-center gap-2 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="currentColor">
            <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"/>
          </svg>
          Trocar livro
        </button>

        <div class="mb-8 flex items-start justify-between flex-wrap gap-4">
          <div>
            <h2 id="livro-titulo" class="text-2xl font-bold lp-text-primary mb-1"></h2>
            <p id="livro-autor" class="lp-text-accent text-sm font-medium"></p>
          </div>
          <div class="text-right">
            <div id="progresso-texto" class="text-sm lp-text-muted mb-1"></div>
            <div class="w-48 h-1.5 lp-progress-track rounded-full overflow-hidden">
              <div id="progresso-barra" class="h-full lp-accent-bg rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>
        </div>

        <div id="grade-dias" class="grid grid-cols-5 sm:grid-cols-8 gap-2"></div>
      </div>

      <!-- VIEW: Conteúdo do Dia -->
      <div id="view-conteudo" class="hidden">
        <div class="max-w-2xl mx-auto px-4 py-10">
          <button id="btn-voltar-dias" class="lp-link mb-8 text-sm flex items-center gap-2 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="currentColor">
              <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"/>
            </svg>
            Todos os dias
          </button>

          <div class="mb-2 lp-text-accent text-xs font-semibold uppercase tracking-widest" id="dia-numero"></div>
          <h2 id="dia-titulo" class="text-2xl sm:text-3xl font-bold lp-text-primary mb-6 leading-tight"></h2>

          <!-- Versículo de abertura -->
          <blockquote id="dia-versiculo-bloco" class="mb-8 border-l-2 lp-quote-border pl-4 hidden">
            <p id="dia-versiculo" class="lp-text-verse italic leading-relaxed"></p>
            <footer id="dia-versiculo-ref" class="mt-2 lp-text-accent text-sm font-medium"></footer>
          </blockquote>

          <!-- Conteúdo -->
          <div id="dia-conteudo" class="prose-custom space-y-4 mb-10"></div>

          <!-- Pense nisso -->
          <div id="dia-pensamento-bloco" class="hidden mb-8 lp-block-surface rounded-xl p-5">
            <div class="text-xs font-semibold uppercase tracking-widest lp-text-accent mb-2">Pense nisso</div>
            <p id="dia-pensamento" class="lp-text-secondary leading-relaxed"></p>
          </div>

          <!-- Versículo para memorizar -->
          <div id="dia-mem-bloco" class="hidden mb-10 lp-block-mem rounded-xl p-5">
            <div class="text-xs font-semibold uppercase tracking-widest lp-text-accent mb-2">Versículo para memorizar</div>
            <p id="dia-mem-versiculo" class="lp-text-secondary italic leading-relaxed mb-1"></p>
            <p id="dia-mem-ref" class="lp-text-accent text-sm font-medium"></p>
          </div>

          <!-- Pergunta -->
          <div id="dia-pergunta-bloco" class="hidden mb-10 lp-block-pergunta rounded-xl p-5">
            <div class="text-xs font-semibold uppercase tracking-widest lp-text-accent mb-2">Pergunta para meditar</div>
            <p id="dia-pergunta" class="lp-text-secondary leading-relaxed"></p>
          </div>

          <!-- Ações -->
          <div class="flex items-center justify-between gap-4 pt-6 lp-divider border-t">
            <button id="btn-dia-anterior" class="lp-nav-btn text-sm flex items-center gap-2 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="currentColor">
                <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"/>
              </svg>
              Dia anterior
            </button>

            <button id="btn-marcar-lido" class="px-5 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200"></button>

            <button id="btn-proximo-dia" class="lp-nav-btn text-sm flex items-center gap-2 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
              Próximo dia
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="currentColor">
                <path d="M40,128a8,8,0,0,1,8-8H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72a8,8,0,0,1,0,11.32l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H48A8,8,0,0,1,40,128Z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

    </main>
  </div>
</BaseLayout>

<style is:global>
  /* ─── Variáveis de tema ─────────────────────────────────── */
  #leitura-root {
    --lp-bg:             #121212;
    --lp-header-bg:      rgba(18, 18, 18, 0.88);
    --lp-header-border:  rgba(255,255,255,0.07);
    --lp-surface:        #1e1e1e;
    --lp-surface-hover:  #252525;
    --lp-border:         rgba(255,255,255,0.08);
    --lp-border-card:    rgba(255,255,255,0.18);
    --lp-text:           #e0e0e0;
    --lp-text-secondary: #c8c8c8;
    --lp-text-muted:     #9ca3af;
    --lp-text-subtle:    #6b7280;
    --lp-accent:         #6366f1;
    --lp-accent-soft:    rgba(99,102,241,0.18);
    --lp-accent-border:  rgba(99,102,241,0.35);
    --lp-prose:          #c8c8c8;
    --lp-surface-2:      rgba(30,30,30,0.7);
    --lp-border-2:       rgba(255,255,255,0.06);
    --lp-mem-bg:         rgba(49,46,129,0.22);
    --lp-mem-border:     rgba(99,102,241,0.2);
    --lp-pergunta-bg:    rgba(30,30,30,0.5);
    --lp-pergunta-border:rgba(255,255,255,0.06);
    --lp-day-empty:      #0f172a;
    --lp-day-empty-bd:   #1e293b;
    --lp-day-empty-text: #475569;
    --lp-progress-track: rgba(255,255,255,0.08);
    --lp-tema-btn-bg:    rgba(255,255,255,0.06);
    --lp-tema-btn-hover: rgba(255,255,255,0.12);
  }

  #leitura-root.light {
    --lp-bg:             #f5f5f5;
    --lp-header-bg:      rgba(245,245,245,0.92);
    --lp-header-border:  rgba(0,0,0,0.09);
    --lp-surface:        #ffffff;
    --lp-surface-hover:  #f9f9f9;
    --lp-border:         rgba(0,0,0,0.1);
    --lp-border-card:    rgba(0,0,0,0.18);
    --lp-text:           #1a1a1a;
    --lp-text-secondary: #2d2d2d;
    --lp-text-muted:     #6b7280;
    --lp-text-subtle:    #9ca3af;
    --lp-accent:         #4f46e5;
    --lp-accent-soft:    rgba(79,70,229,0.12);
    --lp-accent-border:  rgba(79,70,229,0.3);
    --lp-prose:          #374151;
    --lp-surface-2:      rgba(255,255,255,0.85);
    --lp-border-2:       rgba(0,0,0,0.08);
    --lp-mem-bg:         rgba(238,242,255,0.8);
    --lp-mem-border:     rgba(99,102,241,0.2);
    --lp-pergunta-bg:    rgba(255,255,255,0.7);
    --lp-pergunta-border:rgba(0,0,0,0.08);
    --lp-day-empty:      #ebebeb;
    --lp-day-empty-bd:   #d8d8d8;
    --lp-day-empty-text: #adb5bd;
    --lp-progress-track: rgba(0,0,0,0.1);
    --lp-tema-btn-bg:    rgba(0,0,0,0.06);
    --lp-tema-btn-hover: rgba(0,0,0,0.1);
  }

  /* ─── Classes utilitárias de tema ──────────────────────── */
  .lp-root        { background-color: var(--lp-bg); color: var(--lp-text); transition: background-color 0.2s, color 0.2s; }
  .lp-header      { border-bottom: 1px solid var(--lp-header-border); background-color: var(--lp-header-bg); }
  .lp-link        { color: var(--lp-text-muted); }
  .lp-link:hover  { color: var(--lp-accent); }
  .lp-text-primary   { color: var(--lp-text); }
  .lp-text-secondary { color: var(--lp-text-secondary); }
  .lp-text-muted     { color: var(--lp-text-muted); }
  .lp-text-subtle    { color: var(--lp-text-subtle); }
  .lp-text-accent    { color: var(--lp-accent); }
  .lp-text-verse     { color: var(--lp-text-secondary); }
  .lp-quote-border   { border-color: var(--lp-accent); }
  .lp-progress-track { background-color: var(--lp-progress-track); }
  .lp-accent-bg      { background-color: var(--lp-accent); }
  .lp-block-surface  { background-color: var(--lp-surface-2); border: 1px solid var(--lp-border-2); }
  .lp-block-mem      { background-color: var(--lp-mem-bg); border: 1px solid var(--lp-mem-border); }
  .lp-block-pergunta { background-color: var(--lp-pergunta-bg); border: 1px solid var(--lp-pergunta-border); }
  .lp-divider        { border-color: var(--lp-border); }
  .lp-nav-btn        { color: var(--lp-text-muted); }
  .lp-nav-btn:hover  { color: var(--lp-text); }
  .lp-tema-btn { background-color: var(--lp-tema-btn-bg); color: var(--lp-text-muted); }
  .lp-tema-btn:hover { background-color: var(--lp-tema-btn-hover); color: var(--lp-text); }

  .lp-card {
    text-align: left;
    padding: 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--lp-border-card);
    background-color: var(--lp-surface);
    transition: border-color 0.15s, background-color 0.15s;
    width: 100%;
    cursor: pointer;
  }
  .lp-card:hover {
    border-color: var(--lp-accent-border);
    background-color: var(--lp-surface-hover);
  }
  .lp-card-icon {
    width: 2.5rem; height: 2.5rem;
    border-radius: 0.5rem;
    background-color: var(--lp-accent-soft);
    border: 1px solid var(--lp-accent-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--lp-accent);
  }

  /* ─── Cards de dia ──────────────────────────────────────── */
  .prose-custom p { color: var(--lp-prose); line-height: 1.8; }

  .card-dia {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1px solid;
    position: relative;
  }
  .card-dia:hover { transform: scale(1.06); }

  .card-dia.lido {
    background-color: var(--lp-accent-soft);
    border-color: var(--lp-accent-border);
    color: var(--lp-accent);
  }
  .card-dia.lido::after {
    content: '✓';
    position: absolute;
    top: 2px; right: 5px;
    font-size: 0.55rem;
    color: var(--lp-accent);
  }
  .card-dia.nao-lido {
    background-color: var(--lp-surface);
    border-color: var(--lp-border-card);
    color: var(--lp-day-empty-text);
  }
  .card-dia.nao-lido:hover {
    border-color: var(--lp-accent-border);
    color: var(--lp-text-muted);
  }
  .card-dia.bloqueado {
    background-color: var(--lp-day-empty);
    border-color: var(--lp-day-empty-bd);
    color: var(--lp-day-empty-text);
    cursor: not-allowed;
    opacity: 0.5;
  }
  .card-dia.bloqueado:hover {
    transform: none;
    border-color: var(--lp-day-empty-bd);
    color: var(--lp-day-empty-text);
  }
  .card-dia.bloqueado .lock-icon {
    position: absolute;
    top: 3px;
    right: 4px;
    opacity: 0.5;
  }
  .card-dia.atual {
    background-color: var(--lp-accent);
    border-color: var(--lp-accent);
    color: #fff;
    box-shadow: 0 0 0 2px var(--lp-accent-soft);
  }
</style>

<script define:vars={{ dadosLivros }}>
  const livros = JSON.parse(dadosLivros);
  const STORAGE_KEY   = 'leitura-progresso';
  const TEMA_KEY      = 'leitura-tema';
  const root          = document.getElementById('leitura-root');

  /* ─── Tema ────────────────────────────────────────────── */
  function getTema() {
    return localStorage.getItem(TEMA_KEY) || 'dark';
  }

  function aplicarTema(tema) {
    root.classList.toggle('light', tema === 'light');
    localStorage.setItem(TEMA_KEY, tema);
    document.getElementById('icon-sol').classList.toggle('hidden', tema === 'dark');
    document.getElementById('icon-lua').classList.toggle('hidden', tema === 'light');
  }

  document.getElementById('btn-tema').addEventListener('click', () => {
    aplicarTema(getTema() === 'dark' ? 'light' : 'dark');
  });

  aplicarTema(getTema());

  /* ─── Progresso ───────────────────────────────────────── */
  function getProgresso() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); }
    catch { return {}; }
  }
  function salvarProgresso(p) { localStorage.setItem(STORAGE_KEY, JSON.stringify(p)); }
  function isDiaLido(livroId, dia) {
    const p = getProgresso();
    return !!(p[livroId] && p[livroId].includes(dia));
  }
  function toggleDiaLido(livroId, dia) {
    const p = getProgresso();
    if (!p[livroId]) p[livroId] = [];
    const idx = p[livroId].indexOf(dia);
    if (idx >= 0) p[livroId].splice(idx, 1); else p[livroId].push(dia);
    salvarProgresso(p);
  }
  function getDiasLidos(livroId) { return getProgresso()[livroId] || []; }

  /* ─── State ───────────────────────────────────────────── */
  let livroAtual = null;
  let diaAtual   = null;

  const viewLivros   = document.getElementById('view-livros');
  const viewDias     = document.getElementById('view-dias');
  const viewConteudo = document.getElementById('view-conteudo');

  function mostrarView(view) {
    [viewLivros, viewDias, viewConteudo].forEach(v => v.classList.add('hidden'));
    view.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* ─── VIEW: Livros ────────────────────────────────────── */
  function renderLivros() {
    const lista = document.getElementById('lista-livros');
    lista.innerHTML = '';
    livros.forEach(livro => {
      const lidos = getDiasLidos(livro.id).length;
      const pct   = Math.round((lidos / livro.totalDias) * 100);
      const card  = document.createElement('button');
      card.className = 'lp-card';
      card.innerHTML = `
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:0.75rem">
          <div class="lp-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
              <path d="M232,48H160a40,40,0,0,0-32,16A40,40,0,0,0,96,48H24A16,16,0,0,0,8,64V192a16,16,0,0,0,16,16H96a24,24,0,0,1,24,24,8,8,0,0,0,16,0,24,24,0,0,1,24-24h72a16,16,0,0,0,16-16V64A16,16,0,0,0,232,48ZM96,192H24V64H96a24,24,0,0,1,24,24V200A40,40,0,0,0,96,192Zm136,0H160a40,40,0,0,0-24,8V88a24,24,0,0,1,24-24h72Z"/>
            </svg>
          </div>
          <span style="font-size:0.75rem;color:var(--lp-text-subtle)">${livro.totalDias} dias</span>
        </div>
        <h3 style="font-weight:700;color:var(--lp-text);margin-bottom:0.25rem;transition:color 0.15s">${livro.titulo}</h3>
        <p style="font-size:0.75rem;color:var(--lp-accent);margin-bottom:0.25rem">${livro.autor}</p>
        <p style="font-size:0.75rem;color:var(--lp-text-muted);margin-bottom:1rem;line-height:1.5">${livro.descricao}</p>
        <div style="display:flex;align-items:center;justify-content:space-between;font-size:0.75rem;color:var(--lp-text-muted);margin-bottom:0.5rem">
          <span>${lidos} de ${livro.totalDias} dias lidos</span>
          <span style="color:var(--lp-accent);font-weight:600">${pct}%</span>
        </div>
        <div style="height:4px;background-color:var(--lp-progress-track);border-radius:9999px;overflow:hidden">
          <div style="width:${pct}%;height:100%;background-color:var(--lp-accent);border-radius:9999px;transition:width 0.5s"></div>
        </div>
      `;
      card.addEventListener('click', () => { livroAtual = livro; renderDias(); mostrarView(viewDias); });
      lista.appendChild(card);
    });
    mostrarView(viewLivros);
  }

  /* ─── VIEW: Dias ──────────────────────────────────────── */
  function renderDias() {
    if (!livroAtual) return;
    document.getElementById('livro-titulo').textContent = livroAtual.titulo;
    document.getElementById('livro-autor').textContent  = livroAtual.autor;

    const lidos = getDiasLidos(livroAtual.id);
    const pct   = Math.round((lidos.length / livroAtual.totalDias) * 100);
    document.getElementById('progresso-texto').textContent   = `${lidos.length} de ${livroAtual.totalDias} dias lidos`;
    document.getElementById('progresso-barra').style.width   = `${pct}%`;

    const grade = document.getElementById('grade-dias');
    grade.innerHTML = '';
    livroAtual.dias.forEach(dia => {
      const bloqueado = dia.disponivel === false;
      const lido      = !bloqueado && lidos.includes(dia.dia);
      const isAtual   = !bloqueado && dia.dia === diaAtual?.dia;
      const card      = document.createElement('button');

      let classe = 'card-dia ';
      if (bloqueado)   classe += 'bloqueado';
      else if (lido)   classe += 'lido';
      else if (isAtual) classe += 'atual';
      else              classe += 'nao-lido';

      card.className = classe;
      card.title     = bloqueado ? `Dia ${dia.dia} — ainda não disponível` : dia.titulo;
      card.disabled  = bloqueado;
      card.innerHTML = bloqueado
        ? `<span>${dia.dia}</span><svg class="lock-icon" xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 256 256" fill="currentColor"><path d="M208,96H176V72a48,48,0,0,0-96,0V96H48A16,16,0,0,0,32,112V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V112A16,16,0,0,0,208,96ZM96,72a32,32,0,0,1,64,0V96H96ZM208,208H48V112H208V208Z"/></svg>`
        : `<span>${dia.dia}</span>`;

      if (!bloqueado) {
        card.addEventListener('click', () => { diaAtual = dia; renderConteudo(); mostrarView(viewConteudo); });
      }
      grade.appendChild(card);
    });
  }

  /* ─── VIEW: Conteúdo ──────────────────────────────────── */
  function renderConteudo() {
    if (!diaAtual || !livroAtual) return;
    const dia = diaAtual;

    document.getElementById('dia-numero').textContent = `Dia ${dia.dia} de ${livroAtual.totalDias}`;
    document.getElementById('dia-titulo').textContent = dia.titulo;

    const vBloco = document.getElementById('dia-versiculo-bloco');
    if (dia.versiculo) {
      document.getElementById('dia-versiculo').textContent    = dia.versiculo;
      document.getElementById('dia-versiculo-ref').textContent = dia.versiculoRef;
      vBloco.classList.remove('hidden');
    } else {
      vBloco.classList.add('hidden');
    }

    document.getElementById('dia-conteudo').innerHTML = dia.conteudo.map(p => `<p>${p}</p>`).join('');

    const pBloco = document.getElementById('dia-pensamento-bloco');
    if (dia.pensamento) {
      document.getElementById('dia-pensamento').textContent = dia.pensamento;
      pBloco.classList.remove('hidden');
    } else {
      pBloco.classList.add('hidden');
    }

    const mBloco = document.getElementById('dia-mem-bloco');
    if (dia.versiculoMemorizacao) {
      document.getElementById('dia-mem-versiculo').textContent = dia.versiculoMemorizacao;
      document.getElementById('dia-mem-ref').textContent        = dia.versiculoMemorizacaoRef;
      mBloco.classList.remove('hidden');
    } else {
      mBloco.classList.add('hidden');
    }

    const qBloco = document.getElementById('dia-pergunta-bloco');
    if (dia.perguntaParaMeditar) {
      document.getElementById('dia-pergunta').textContent = dia.perguntaParaMeditar;
      qBloco.classList.remove('hidden');
    } else {
      qBloco.classList.add('hidden');
    }

    atualizarBtnMarcar(document.getElementById('btn-marcar-lido'), isDiaLido(livroAtual.id, dia.dia));
    document.getElementById('btn-dia-anterior').disabled = dia.dia <= 1;
    document.getElementById('btn-proximo-dia').disabled  = dia.dia >= livroAtual.totalDias;
  }

  function atualizarBtnMarcar(btn, lido) {
    if (lido) {
      btn.textContent = '✓ Lido';
      btn.style.cssText = `
        background-color: var(--lp-accent-soft);
        border: 1px solid var(--lp-accent-border);
        color: var(--lp-accent);
        padding: 0.625rem 1.25rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.2s;
        cursor: pointer;
      `;
    } else {
      btn.textContent = 'Marcar como lido';
      btn.style.cssText = `
        background-color: var(--lp-accent);
        color: #fff;
        border: none;
        padding: 0.625rem 1.25rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.2s;
        cursor: pointer;
        opacity: 1;
      `;
    }
  }

  /* ─── Eventos ─────────────────────────────────────────── */
  document.getElementById('btn-voltar-livros').addEventListener('click', () => { diaAtual = null; renderLivros(); });
  document.getElementById('btn-voltar-dias').addEventListener('click', () => { renderDias(); mostrarView(viewDias); });

  document.getElementById('btn-marcar-lido').addEventListener('click', () => {
    if (!livroAtual || !diaAtual) return;
    toggleDiaLido(livroAtual.id, diaAtual.dia);
    atualizarBtnMarcar(document.getElementById('btn-marcar-lido'), isDiaLido(livroAtual.id, diaAtual.dia));
  });

  document.getElementById('btn-dia-anterior').addEventListener('click', () => {
    if (!diaAtual || diaAtual.dia <= 1) return;
    diaAtual = livroAtual.dias[diaAtual.dia - 2];
    renderConteudo();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  document.getElementById('btn-proximo-dia').addEventListener('click', () => {
    if (!diaAtual || diaAtual.dia >= livroAtual.totalDias) return;
    diaAtual = livroAtual.dias[diaAtual.dia];
    renderConteudo();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  /* ─── Init ────────────────────────────────────────────── */
  renderLivros();
</script>
